rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared UAT Firestore rules for:
    // - hockey-2026 squad tracker
    // - mentone-fixture public fixture app
    //
    // Firestore rules are project-wide. Keep this file in sync with the
    // mentone-fixture repo before deploying rules to hockey-2026-uat.

    // Mentone Fixture app collections: public read, server/admin writes only.
    match /teams/{teamId}          { allow read: if true; allow write: if false; }
    match /fixtures/{fixtureId}    { allow read: if true; allow write: if false; }
    match /competitions/{compId}   { allow read: if true; allow write: if false; }
    match /ladders/{teamId}        { allow read: if true; allow write: if false; }
    match /clubOverrides/{rawName} { allow read: if true; allow write: if false; }
    match /syncState/{compId}      { allow read: if true; allow write: if false; }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userAccessDoc() {
      return /databases/$(database)/documents/allowedUsers/$(request.auth.token.email);
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'steve.g.waters@gmail.com';
    }

    function isApprovedTrackerUser() {
      return isBootstrapAdmin()
        || (isSignedIn()
          && exists(userAccessDoc())
          && get(userAccessDoc()).data.enabled == true);
    }

    function isTrackerAdmin() {
      return isBootstrapAdmin()
        || (isApprovedTrackerUser()
          && get(userAccessDoc()).data.role == 'admin');
    }

    function pollData(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    // Public unless isPrivate is explicitly true. Admins see all; others see public + own private.
    function pollIsPublic(data) {
      return !('isPrivate' in data) || data.isPrivate != true;
    }

    function canBrowsePoll(data) {
      return isTrackerAdmin()
        || pollIsPublic(data)
        || (data.createdByEmail != null && data.createdByEmail == authEmailLower());
    }

    // Squad tracker collections.
    match /config/{docId} {
      allow read, write: if isApprovedTrackerUser();
    }
    match /players/{playerId} {
      allow read, write: if isApprovedTrackerUser();
    }
    match /rounds/{roundId} {
      // Public vote links list season rounds to resolve readable round keys.
      allow read: if true;
      allow write: if isApprovedTrackerUser();
    }
    match /rounds/{roundId}/{document=**} {
      allow read, write: if isApprovedTrackerUser();
    }
    match /playerUnavailability/{docId} {
      allow read, write: if isApprovedTrackerUser();
    }
    match /unavailabilitySubmissions/{submissionId} {
      // Public form writes go through Cloud Functions. Tracker admins review
      // staged submissions here before promoting them to playerUnavailability.
      allow read, write: if isTrackerAdmin();
    }
    match /unavailabilitySubmitterLinks/{emailId} {
      // Admin-maintained email-to-player links used by public lookup functions.
      allow read, write: if isTrackerAdmin();
    }
    match /unavailabilitySyncLog/{logId} {
      // Sheet auto-sync and manual sync pickup history (admin activity feed).
      allow read, create: if isTrackerAdmin();
      allow update, delete: if false;
    }
    match /votes/{voteId} {
      // Public vote links can read a known session doc; listing sessions is tracker-only.
      allow get: if true;
      allow list: if isApprovedTrackerUser();
      allow create, update, delete: if isApprovedTrackerUser();
    }
    match /votes/{voteId}/responses/{responseId} {
      allow create: if true;
      allow read, update, delete: if isTrackerAdmin();
    }
    match /polls/{pollId} {
      // Public poll links: read one poll by id without signing in.
      allow get: if true;
      // Registry: any approved tracker user may list/browse polls that are public or their own private polls.
      allow list: if isApprovedTrackerUser() && canBrowsePoll(resource.data);
      allow create, update, delete: if isTrackerAdmin();
    }
    match /polls/{pollId}/responses/{responseId} {
      // Public responses are written by Cloud Function only.
      allow create: if false;
      allow read: if isApprovedTrackerUser() && canBrowsePoll(pollData(pollId));
      allow update, delete: if isTrackerAdmin();
    }
    match /allowedUsers/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if isTrackerAdmin();
    }
    match /hvSync/{docId} {
      allow read, write: if isApprovedTrackerUser();
    }
    match /weeklyDigests/{docId} {
      allow read, write: if isApprovedTrackerUser();
    }
  }
}
